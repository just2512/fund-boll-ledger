{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "基金阶梯账本",
  "version": "0.2.0",
  "identifier": "com.just2512.fundbollledger",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "基金阶梯账本",
        "width": 1220,
        "height": 850,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Finance",
    "shortDescription": "场内基金价格阶梯计算和手动交易账本",
    "longDescription": "手动录入 BOLL 参考价、成交价与交易费用，计算十档价格阶梯并记录场内基金持仓盈亏。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "android": {
      "minSdkVersion": 24,
      "versionCode": 2000,
      "autoIncrementVersionCode": false
    }
  }
}
