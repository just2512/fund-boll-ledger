{
  "$schema": "../gen/schemas/desktop-schema.json",
  "description": "基金阶梯账本的最小默认权限",
  "identifier": "default",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    { "identifier": "fs:allow-write-text-file", "allow": [{ "path": "**" }] },
    { "identifier": "fs:allow-read-text-file", "allow": [{ "path": "**" }] }
  ]
}
